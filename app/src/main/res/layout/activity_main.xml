<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayout"
    android:background="@drawable/bg_radio"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Текст статуса воспроизведения -->
    <TextView
        android:id="@+id/statusTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Выберите радиостанцию"
        android:textSize="18sp"
        android:padding="8dp" />

    <!-- Индикатор загрузки -->
    <ProgressBar
        android:id="@+id/loadingProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <!-- Название текущей радиостанции -->
    <TextView
        android:id="@+id/stationNameTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="16sp"
        android:padding="8dp" />

    <!-- Сетка кнопок с радиостанциями -->
    <GridLayout
        android:id="@+id/mainGridLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="2"
        android:rowCount="3"
        android:alignmentMode="alignMargins"
        android:columnOrderPreserved="false"
        android:useDefaultMargins="true">

        <LinearLayout
            android:id="@+id/buttonBulgar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/rounded_corners"
                android:clipToOutline="true"
                android:layout_marginVertical="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/bulgar_radio_icon"
                android:src="@drawable/ic_bulgar" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/buttonTartip"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/tartip_radio_icon"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_tartip"
                android:layout_marginVertical="8dp"
                android:background="@drawable/rounded_corners"
                android:clipToOutline="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/buttonTatarRadio"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/tatar_radio_icon"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_tatar"
                android:layout_marginVertical="8dp"
                android:background="@drawable/rounded_corners"
                android:clipToOutline="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/buttonKunel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/kunel_radio_icon"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_kunel"
                android:background="@drawable/rounded_corners"
                android:layout_marginVertical="8dp"
                android:clipToOutline="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/buttonKurai"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/kurai_radio_icon"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_kurai"
                android:background="@drawable/rounded_corners"
                android:layout_marginVertical="8dp"
                android:clipToOutline="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/buttonKitapFM"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/kitap_radio_icon"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_kitap"
                android:background="@drawable/rounded_corners"
                android:layout_marginVertical="8dp"
                android:clipToOutline="true" />
        </LinearLayout>

    </GridLayout>

</LinearLayout>